generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  password_hash String
  role          String
  phc_id        String?
  phc           PHC?         @relation(fields: [phc_id], references: [id])
  audit_logs    AuditLog[]
  requested     TransferRequest[] @relation("RequestedBy")
  approved      TransferRequest[] @relation("ApprovedBy")
  created_at    DateTime    @default(now())
}

model PHC {
  id          String      @id @default(cuid())
  name        String
  district    String
  latitude    Float
  longitude   Float
  phone       String
  users       User[]
  stocks      Stock[]
  consumption ConsumptionLog[]
  alerts      Alert[]
  outgoing    TransferRequest[] @relation("FromPHC")
  incoming    TransferRequest[] @relation("ToPHC")
}

model Medicine {
  id            String      @id @default(cuid())
  name          String      @unique
  category      String
  unit          String
  is_essential  Boolean     @default(true)
  stocks        Stock[]
  consumption   ConsumptionLog[]
  alerts        Alert[]
  transfers     TransferRequest[]
  warehouse     WarehouseStock[]
}

model Stock {
  id          String   @id @default(cuid())
  phc_id      String
  medicine_id String
  batch_no    String
  quantity    Int
  expiry_date DateTime
  updated_at  DateTime @updatedAt
  phc         PHC      @relation(fields: [phc_id], references: [id], onDelete: Cascade)
  medicine    Medicine @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  @@unique([phc_id, medicine_id, batch_no])
  @@index([phc_id, medicine_id])
}

model ConsumptionLog {
  id            String   @id @default(cuid())
  phc_id        String
  medicine_id   String
  date          DateTime
  quantity_used Int
  phc           PHC      @relation(fields: [phc_id], references: [id], onDelete: Cascade)
  medicine      Medicine @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  @@index([phc_id, medicine_id, date])
}

model Alert {
  id          String   @id @default(cuid())
  phc_id      String
  medicine_id String
  type        String
  severity    String
  message     String
  days_left   Float?
  status      String   @default("OPEN")
  created_at  DateTime @default(now())
  phc         PHC      @relation(fields: [phc_id], references: [id], onDelete: Cascade)
  medicine    Medicine @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  @@index([phc_id, status, created_at])
  @@index([medicine_id, status])
}

model TransferRequest {
  id            String   @id @default(cuid())
  from_phc_id   String?
  to_phc_id     String
  medicine_id   String
  quantity      Int
  type          String
  status        String   @default("PENDING")
  requested_by  String
  approved_by   String?
  reason        String
  created_at    DateTime @default(now())
  decided_at    DateTime?
  from_phc      PHC?     @relation("FromPHC", fields: [from_phc_id], references: [id])
  to_phc        PHC      @relation("ToPHC", fields: [to_phc_id], references: [id])
  medicine      Medicine @relation(fields: [medicine_id], references: [id])
  requester     User     @relation("RequestedBy", fields: [requested_by], references: [id])
  approver      User?    @relation("ApprovedBy", fields: [approved_by], references: [id])
  @@index([status, created_at])
}

model DistrictWarehouse {
  id        String   @id @default(cuid())
  district  String   @unique
  latitude  Float
  longitude Float
  stocks    WarehouseStock[]
}

model WarehouseStock {
  id           String           @id @default(cuid())
  warehouse_id String
  medicine_id  String
  quantity     Int
  expiry_date  DateTime
  warehouse    DistrictWarehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  medicine     Medicine         @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  @@unique([warehouse_id, medicine_id])
}

model AuditLog {
  id        String   @id @default(cuid())
  user_id   String
  action    String
  entity    String
  entity_id String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [user_id], references: [id])
  @@index([entity, entity_id])
}

model SyncRecord {
  id          String   @id @default(cuid())
  client_id   String   @unique
  client_time DateTime
  created_at  DateTime @default(now())
}